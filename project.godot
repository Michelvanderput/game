; Engine configuration file.
; Edited by hand and by the Godot editor; keep settings in sync with CLAUDE.md.

config_version=5

[application]

config/name="Nachtlicht"
config/description="Top-down action roguelite. Werktitel."
run/main_scene="res://src/rooms/test_room.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EventBus="*res://src/core/event_bus.gd"
Rng="*res://src/core/rng.gd"
GameState="*res://src/core/game_state.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

